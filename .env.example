# =====================================================================
# W29 — API (roda na VPS)
#
#     cp .env.example .env
#
# O .env fica SÓ na VPS. Nunca entra no git, nunca vai pra Vercel —
# a Vercel só precisa saber a URL desta API, mais nada.
# =====================================================================

# ------------------------------------------------------------ servidor
PORTA=3333

# Domínio(s) do front que podem chamar esta API, separados por vírgula.
# Precisa ser a origem exata (com https://, sem barra no fim). Um "*"
# aqui não funciona: a API manda cookie, e o navegador recusa
# credenciais para origem curinga.
ORIGENS_PERMITIDAS=http://localhost:3000,https://w29.vercel.app

# --------------------------------------------------------------- MySQL
DB_HOST=127.0.0.1
DB_PORTA=3306
DB_USUARIO=w29
DB_SENHA=
DB_NOME=w29

# ----------------------------------------------------------------- JWT
# Segredo de assinatura do token. Gere um novo e guarde só na VPS:
#     node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Trocar este valor derruba a sessão de todo mundo — que é exatamente
# o que você quer se ele algum dia vazar.
JWT_SEGREDO=

# Quanto tempo o login dura. Aceita 15m, 8h, 30d.
#
# O front renova a sessão sozinho enquanto a pessoa usa o app, então este
# número é quanto tempo alguém pode ficar SEM abrir o app antes de ter de
# entrar de novo. Curto demais (7d) e o operador que passou as férias fora
# volta para a tela de login.
JWT_VALIDADE=30d

# Domínio do cookie de sessão.
#
# Deixe VAZIO enquanto o front estiver num *.vercel.app: front e API em
# domínios diferentes viram "cross-site", e aí o cookie precisa sair com
# SameSite=None; Secure (a API já faz isso sozinha quando não há domínio).
#
# Quando os dois estiverem sob o mesmo domínio — app.seudominio.com e
# api.seudominio.com — ponha ".seudominio.com" aqui. O cookie passa a ser
# same-site, ganha SameSite=Lax e para de depender de o navegador aceitar
# cookie de terceiro (Safari e o modo anônimo do Chrome bloqueiam).
COOKIE_DOMINIO=
